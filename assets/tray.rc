#include <windows.h>

1 ICON "assets/dflow-dictation.ico"

100 DIALOGEX 0, 0, 276, 139
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DFlow Dictation Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Dictation shortcut", -1, 8, 10, 85, 10
    EDITTEXT 101, 94, 8, 174, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Microphone", -1, 8, 30, 85, 10
    COMBOBOX 102, 94, 28, 174, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Codex auth file", -1, 8, 50, 85, 10
    EDITTEXT 103, 94, 48, 174, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Use transcription proxy", 104, 8, 68, 88, 12, WS_TABSTOP
    EDITTEXT 105, 94, 67, 174, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Start with Windows", 106, 8, 91, 100, 12, WS_TABSTOP
    DEFPUSHBUTTON "Save", IDOK, 160, 116, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 218, 116, 50, 14, WS_TABSTOP
END
